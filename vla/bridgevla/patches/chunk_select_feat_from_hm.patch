+        chunk_dis = 1 / (torch.sqrt(torch.sum((chunk_con - chunk_pt4) ** 2, dim=-1)) + 1e-10)
+        chunk_wei2 = chunk_wei.unsqueeze(-1) * chunk_dis
+        _w = torch.sum(chunk_wei2, dim=-1, keepdim=True)
+        _w[_w == 0.0] = 1
+        chunk_wei2 = chunk_wei2 / _w                            # [nc, ce, 4]
