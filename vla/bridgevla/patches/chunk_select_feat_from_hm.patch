# =============================================================================
# chunk_select_feat_from_hm.patch
# =============================================================================
# Purpose:
#   Make BridgeVLA's point-renderer rvt_ops.{select_feat_from_hm,
#   select_feat_from_hm_cache} fit in 12 GB VRAM (RTX 3060). The originals
#   allocate intermediate [nc, npt, 4, 2] int64 and [nc, npt, 4, nw] float
#   tensors that peak around 2 GiB for typical cube resolutions, on top of
#   the bf16 PaliGemma-3B backbone (~6 GB weights + ~4 GB activations).
#
# Strategy:
#   - Chunk along the `npt` axis so the big intermediates never materialize
#     in full.
#   - Pre-allocate the three output tensors and write each chunk in-place
#     so the final torch.cat never happens (avoids a second peak).
#   Per-iteration peak: ~200 MB. Outputs: same semantics as the originals.
#   Chunk size tunable via env BRIDGEVLA_RVT_CHUNK (default 500_000).
#
# Apply (idempotent via --forward):
#   cd /workspace/BridgeVLA/finetune
#   patch -p1 --forward < chunk_select_feat_from_hm.patch
# =============================================================================
--- a/bridgevla/libs/point-renderer/point_renderer/rvt_ops.py
+++ b/bridgevla/libs/point-renderer/point_renderer/rvt_ops.py
