# =============================================================================
# bypass_demo_loading.patch
# =============================================================================
# Purpose:
#   Bypass disk-backed demo loading inside
#   CustomMultiTaskRLBenchEnv2.reset_to_demo() so the BridgeVLA eval pipeline
#   can run end-to-end without any recorded demo data on disk.
#
# Behavior:
#   - If a dataset_root was provided (self._task._dataset_root is non-empty),
#     the original behavior is preserved: pull demo `i` from disk and call
#     task.reset_to_demo(d).
#   - If dataset_root is empty (no demos available), fall back to a fresh
#     procedural scene via self._task.set_variation(0) + self._task.reset(),
#     which returns (descriptions, observation) on stepjam-RLBench (and the
#     buttomnutstoast fork is API-compatible at this layer).
#
#   The `self._lang_goal = desc[0]` line and all recording/episode counters
#   remain untouched.
#
# Target file:
#   RLBench/utils/custom_rlbench_env.py  (the small ~50-line subclass)
#
# How to apply (from inside the BridgeVLA finetune dir):
#   cd /workspace/BridgeVLA/finetune
#   patch -p1 < /path/to/bypass_demo_loading.patch
#
# Verification notes (recorded by author):
#   V1: `_dataset_root` is stored on TaskEnvironment (rlbench/task_environment.py
#       line 43), so `self._task._dataset_root` IS valid on the env wrapper
#       once .launch() has been called (which is guaranteed before
#       reset_to_demo).
#   V2: TaskEnvironment.reset() returns (List[str], Observation) on stepjam
#       HEAD (rlbench/task_environment.py line 75). The buttomnutstoast fork
#       at 587a6a0e6 is forked from stepjam and is API-compatible here.
#   V3: close_jar (and all PerAct-18 color/shape tasks) have variation_count
#       >= 1; variation 0 of close_jar is "close the red jar".
# =============================================================================
--- a/RLBench/utils/custom_rlbench_env.py
+++ b/RLBench/utils/custom_rlbench_env.py
@@ -22,13 +22,23 @@ class CustomMultiTaskRLBenchEnv2(CustomMultiTaskRLBenchEnv):
         self._episodes_this_task += 1

         self._i = 0
-        self._task.set_variation(-1)
-        d = self._task.get_demos(
-            1, live_demos=False, random_selection=False, from_episode_number=i
-        )[0]
-
-        self._task.set_variation(d.variation_number)
-        desc, obs = self._task.reset_to_demo(d)
+        # If no dataset_root was provided, the underlying TaskEnvironment
+        # cannot load demos from disk. Fall back to a fresh procedural scene
+        # via task.reset() so the eval pipeline can still run without any
+        # recorded demo data.
+        _dsr = getattr(self._task, "_dataset_root", "") or ""
+        if len(_dsr) == 0:
+            # Use variation 0 for reproducibility across the run.
+            self._task.set_variation(0)
+            desc, obs = self._task.reset()
+        else:
+            self._task.set_variation(-1)
+            d = self._task.get_demos(
+                1, live_demos=False, random_selection=False, from_episode_number=i
+            )[0]
+
+            self._task.set_variation(d.variation_number)
+            desc, obs = self._task.reset_to_demo(d)
         self._lang_goal = desc[0]

         self._previous_obs_dict = self.extract_obs(obs)
