# RLBench source ends up at /opt/RLBench via `COPY . /opt/RLBench` in
# docker/Dockerfile. VLA Dockerfiles under vla/<name>/ build with this repo
# root as the context too, and only COPY their own entrypoint.sh into the image
# (no `COPY . ...`). So we exclude everything Docker-side and re-include only
# the per-VLA entrypoints.

# Base RLBench docker setup — keep entrypoint accessible to the build context.
docker/
!docker/entrypoint.sh

# Per-VLA Docker overlays — each VLA exempts its own entrypoint.
# Add `!vla/<new_vla>/entrypoint.sh` lines here when adding a new VLA folder.
vla/
!vla/bridgevla/entrypoint.sh

# Version control
.git/
.gitignore
.github/

# Caches / build artifacts
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
*.egg-info/
build/
dist/

# IDE / editor cruft
.vscode/
.idea/
*.swp
*.swo

# Local outputs / scratch
/tmp/
